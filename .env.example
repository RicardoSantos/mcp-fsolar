# ── Required ──────────────────────────────────────────────────────────────────

# Felicity Solar cloud account credentials
# Type: string (email)
FELICITY_USER=your@email.com
# Type: string (password)
FELICITY_PASS=yourpassword

# ── Server ────────────────────────────────────────────────────────────────────

# HTTP port to listen on
# Type: integer  Default: 3010  Range: 1024–65535
FELICITY_PORT=3010

# Transport mode: http (REST+SSE) | stdio (MCP pipe) | auto (detect via stdin)
# Type: enum  Default: auto (stdio when stdin is not a TTY, else http)
# FELICITY_MODE=http

# ── Polling ───────────────────────────────────────────────────────────────────

# How often to poll Felicity cloud for fresh battery data (milliseconds)
# Type: integer  Default: 30000  Range: 5000–300000
FELICITY_POLL_MS=30000

# ── Snapshots ─────────────────────────────────────────────────────────────────

# Enable intraday battery snapshots (used for trend + autonomy computation)
# Type: boolean  Default: true
# FELICITY_SNAPSHOT_ENABLED=true

# Interval between intraday snapshots (milliseconds)
# Type: integer  Default: 600000 (10 min)  Range: 60000–3600000
# FELICITY_SNAPSHOT_MS=600000

# How many days of intraday snapshots to retain
# Type: integer  Default: 3  Range: 1–30
# FELICITY_SNAPSHOT_DAYS=3

# How many days of daily energy history to retain
# Type: integer  Default: 90  Range: 7–365
# FELICITY_DAILY_DAYS=90

# Directory for all persistence files (state, snapshots, hooks, cooldowns)
# Type: path  Default: OS temp directory
# SNAPSHOT_DIR=/var/lib/fsolar

# ── Security ──────────────────────────────────────────────────────────────────

# API key — if set, all REST endpoints require Bearer token or X-API-Key header
# (Never pass in query string — keys in URLs appear in access logs)
# Type: string  Default: none (open access)
# FELICITY_API_KEY=change-me-32-chars-minimum

# CORS allowed origin — defaults to localhost:* only
# Set to * to allow all origins (not recommended in production)
# Type: string or *  Default: localhost only
# FELICITY_CORS_ORIGIN=https://dashboard.internal

# Max requests per IP per minute; 0 to disable rate limiting
# Type: integer  Default: 60  Range: 0–10000
# FELICITY_RATE_LIMIT=60

# Trust X-Forwarded-For for rate limiting (set to 1 when behind nginx/Caddy/traefik)
# Type: 0 | 1  Default: 0 (disabled)
# FELICITY_TRUST_PROXY=0

# Global HMAC signing secret for outbound webhook deliveries
# When set, adds X-Hub-Signature-256 to ALL webhook POST requests
# (Overridden per-hook if the hook was registered with its own secret)
# Type: string  Default: none (no signing unless per-hook secret set)
# FELICITY_WEBHOOK_SECRET=

# ── Alerts ────────────────────────────────────────────────────────────────────

# Low state-of-charge threshold for LOW_SOC webhook events (percent)
# Type: integer  Default: 20  Range: 1–99
# FELICITY_LOW_SOC_PCT=20
